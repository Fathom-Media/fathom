# The ffmpeg bundled beside fathom.exe in the Windows build (windows.yml,
# "Bundle ffmpeg"): Gyan Doshi's essentials build of this FFmpeg release, and
# the SHA-256 of its zip, which the build checks before using it.
#
# Kept outside .github/workflows so the weekly ffmpeg-update check can propose
# a new version (GitHub doesn't let automation edit workflow files).
FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba
