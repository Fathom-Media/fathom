# Maintainer: thebigjoe1 <26659217+thebigjoe1@users.noreply.github.com>
#
# Repackages the official AppImage, which is how a -bin package is expected to
# work on the AUR: no Flutter SDK needed to install, and the binary is the one
# that was released and smoke-tested in CI. The AppImage is extracted rather
# than installed whole, so Fathom gets a real /usr/bin entry, .desktop file and
# icons like any other application.
pkgname=fathom-bin
_appname=Fathom
pkgver=0.13.0
pkgrel=1
pkgdesc="A modern Jellyfin client for desktop: films, shows, music, live TV, YouTube and Jellyseerr"
arch=('x86_64' 'aarch64')
url="https://github.com/Fathom-Media/fathom"
license=('AGPL-3.0-or-later')
# libmpv does the decoding and talks to the host GPU drivers, so it is a real
# runtime dependency rather than something bundled.
depends=('gtk3' 'mpv' 'libsecret' 'libayatana-appindicator')
provides=('fathom')
conflicts=('fathom')
options=('!strip')
source_x86_64=("$pkgname-$pkgver-x86_64.AppImage::$url/releases/download/v$pkgver/Fathom-x86_64.AppImage")
source_aarch64=("$pkgname-$pkgver-aarch64.AppImage::$url/releases/download/v$pkgver/Fathom-aarch64.AppImage")
# Filled in per release with `updpkgsums`.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

_appimage() {
  echo "$pkgname-$pkgver-$CARCH.AppImage"
}

prepare() {
  chmod +x "$(_appimage)"
  ./"$(_appimage)" --appimage-extract >/dev/null
}

package() {
  cd "$srcdir/squashfs-root"

  # Flutter looks for lib/ and data/ next to the executable (rpath $ORIGIN/lib),
  # so the bundle stays together under /opt and /usr/bin gets a symlink.
  install -d "$pkgdir/opt/app.fathom.player"
  cp -a usr/bin/. "$pkgdir/opt/app.fathom.player/"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/app.fathom.player/fathom "$pkgdir/usr/bin/fathom"

  install -Dm644 usr/share/applications/app.fathom.player.desktop \
    "$pkgdir/usr/share/applications/app.fathom.player.desktop"
  install -Dm644 usr/share/metainfo/app.fathom.player.metainfo.xml \
    "$pkgdir/usr/share/metainfo/app.fathom.player.metainfo.xml"

  for _icon in usr/share/icons/hicolor/*/apps/app.fathom.player.png; do
    _size="$(basename "$(dirname "$(dirname "$_icon")")")"
    install -Dm644 "$_icon" \
      "$pkgdir/usr/share/icons/hicolor/$_size/apps/app.fathom.player.png"
  done
}
